# =============================================================================
# Zenaipex AI — Platform Environment Variables
# =============================================================================

# --- Platform Identity ---
APP_NAME="ZeniaOne"
APP_ENV=development               # development | staging | production; production/staging must be explicit
APP_BASE_URL=http://localhost:8003
APP_SECRET_KEY=                   # REQUIRED: 64+ char random string for JWT signing
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME="Platform Admin"
SENTRY_DSN=                        # Optional: Sentry project DSN
SENTRY_TRACES_SAMPLE_RATE=0.1
ATLAS_BACKUP_VERIFIED=false        # Operator-confirmed Atlas backup/PITR readiness
STAGING_BASE_URL=                  # Isolated staging API base URL
UPTIME_MONITOR_URL=                # External uptime monitoring URL

# --- MongoDB (Shared DB, all tenants) ---
MONGODB_URI=                      # e.g. mongodb+srv://...
MONGODB_DB_NAME=zenaipex          # Platform database name
REDIS_URL=                         # Optional shared cache URL, e.g. redis://...
REDIS_CACHE_TTL_SECONDS=300
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20
BILLING_WEBHOOK_SECRET=           # Optional; payment webhook fails closed when blank
EXOTEL_WEBHOOK_SECRET=            # Required for signed Exotel callback URLs in production

# --- Admin Bootstrapping ---
ADMIN_EMAIL=admin@example.com     # Default admin email for local dev/seeding
ADMIN_PASSWORD=change_this_pass   # Default admin password for local dev/seeding
ADMIN_NAME="Platform Admin"       # Default admin name


# --- Pinecone (Single index, per-company namespaces) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=zenaipex-knowledge
PINECONE_DIMENSION=384
PINECONE_REGION=us-east-1
PINECONE_CLOUD=aws

# --- Embedding Model ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- LLM Provider Abstraction ---
LLM_PROVIDER=sarvam               # sarvam | gemini | groq

# --- Sarvam AI (Platform-owned, shared across tenants) ---
SARVAM_API_KEY=
SARVAM_API_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_STT_WS_URL=wss://api.sarvam.ai/speech-to-text/ws
SARVAM_TTS_WS_URL=wss://api.sarvam.ai/text-to-speech/ws
DEFAULT_LANGUAGE=hi-IN

# --- Google Gemini ---
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# Optional OpenAI-compatible providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# NVIDIA NIM
NVIDIA_API_KEY_1=
NVIDIA_MODEL_1=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL_1=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY_2=
NVIDIA_MODEL_2=deepseek-ai/deepseek-v4-flash-0731
NVIDIA_BASE_URL_2=https://integrate.api.nvidia.com/v1

# --- Twilio (Platform-owned, shared across tenants initially) ---
# Note: In Phase 3, each company can bring their own Twilio creds.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_PHONE_NUMBER=

# --- Voice / telephony fallbacks ---
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
ENABLEX_WEBHOOK_SECRET=

# --- Platform Webhook Base URL ---
# The public URL where Twilio will send webhooks (ngrok in dev, real domain in prod)
PLATFORM_WEBHOOK_BASE_URL=

# --- Development helpers ---
NGROK_URL=
ZENIA_NGROK_DOMAIN=nonperverse-bess-unplayfully.ngrok-free.dev
ZENIA_BACKEND_PORT=8003
ZENIA_DEV_RELOAD=true

# --- JWT Configuration ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Encryption (for storing Twilio/API secrets in DB) ---
ENCRYPTION_KEY=                   # Fernet key: run `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`

# --- Email (for verification emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@zenaipex.ai

# --- Subscription Limits (platform defaults) ---
FREE_TRIAL_CALL_MINUTES=60
FREE_TRIAL_AGENTS=1
FREE_TRIAL_KB_DOCS=10
FREE_TRIAL_DAYS=14

STARTER_CALL_MINUTES=500
STARTER_AGENTS=3
STARTER_KB_DOCS=100

PRO_CALL_MINUTES=2000
PRO_AGENTS=10
PRO_KB_DOCS=1000

ENTERPRISE_CALL_MINUTES=999999
ENTERPRISE_AGENTS=999999
ENTERPRISE_KB_DOCS=999999
