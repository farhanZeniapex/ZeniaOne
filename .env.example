# =============================================================================
# ZeniaOne — unified environment template
# Copy to .env for local development. Never commit real secrets.
# =============================================================================

# --- Platform / local development ---
APP_NAME=ZeniaOne
APP_ENV=development
APP_BASE_URL=http://localhost:8003
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_SECRET_KEY=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Platform Admin
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ATLAS_BACKUP_VERIFIED=false
STAGING_BASE_URL=
UPTIME_MONITOR_URL=

# --- MongoDB / cache / rate limits ---
MONGODB_URI=
MONGODB_DB_NAME=zenaipex
REDIS_URL=
REDIS_CACHE_TTL_SECONDS=300
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20

# --- Pinecone / embeddings ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=zenaipex-knowledge
PINECONE_DIMENSION=384
PINECONE_REGION=us-east-1
PINECONE_CLOUD=aws
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# --- Provider selection ---
LLM_PROVIDER=sarvam

# --- Sarvam AI ---
SARVAM_API_KEY=
SARVAM_API_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_STT_WS_URL=wss://api.sarvam.ai/speech-to-text/ws
SARVAM_TTS_WS_URL=wss://api.sarvam.ai/text-to-speech/ws
DEFAULT_LANGUAGE=hi-IN
LLM_API_URL=https://api.sarvam.ai/v1
LLM_MODEL=sarvam-105b-conversations
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.95

# --- Google Gemini ---
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Groq / optional LLM providers ---
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# --- NVIDIA NIM ---
NVIDIA_API_KEY_1=
NVIDIA_MODEL_1=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL_1=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY_2=
NVIDIA_MODEL_2=deepseek-ai/deepseek-v4-flash-0731
NVIDIA_BASE_URL_2=https://integrate.api.nvidia.com/v1

# --- Voice / telephony ---
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_PHONE_NUMBER=
TWILIO_PHONE_NUMBER=
PERSONAL_PHONE=
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_WEBHOOK_SECRET=
ENABLEX_WEBHOOK_SECRET=

# --- Public webhook URL ---
PLATFORM_WEBHOOK_BASE_URL=
# Local legacy aliases used by standalone helper scripts:
NGROK_URL=
ZENIA_NGROK_DOMAIN=nonperverse-bess-unplayfully.ngrok-free.dev
ZENIA_BACKEND_PORT=8003
ZENIA_DEV_RELOAD=true

# --- Security / webhooks / encryption ---
BILLING_WEBHOOK_SECRET=
ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@zenaipex.ai

# --- Google Sheets (optional legacy integration) ---
GOOGLE_SHEETS_WEBHOOK_URL=

# --- Plan limits ---
FREE_TRIAL_CALL_MINUTES=60
FREE_TRIAL_AGENTS=1
FREE_TRIAL_KB_DOCS=10
FREE_TRIAL_DAYS=14
STARTER_CALL_MINUTES=500
STARTER_AGENTS=3
STARTER_KB_DOCS=100
PRO_CALL_MINUTES=2000
PRO_AGENTS=10
PRO_KB_DOCS=1000
ENTERPRISE_CALL_MINUTES=999999
ENTERPRISE_AGENTS=999999
ENTERPRISE_KB_DOCS=999999
VOICE_HISTORY_WINDOW_SIZE=24
AI_BILLING_ENFORCEMENT=true
