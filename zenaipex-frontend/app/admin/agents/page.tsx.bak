"use client";

import { useEffect, useState, useMemo, useRef } from "react";
import { fetchApi } from "@/lib/api/client";
import { VOICES, Voice, getVoiceById, getVoiceAcoustics, findBrowserVoice } from "@/lib/data/voices";
import { formatSystemDateTime } from "@/lib/utils";
import {
  Phone, Search, Filter, Play, Square, Loader2, Check, ChevronDown,
  Volume2, Users, Building2, Sparkles, CheckCircle2, Bot, Layers,
  Mic, ShieldCheck, ArrowRight, RefreshCw, Sliders, Cpu, Activity,
  Settings2, X, Globe, Radio, ExternalLink, HelpCircle, StopCircle,
  Calendar, Download, AlertTriangle, Pause, MoreVertical, Edit3, Pin, Trash2, Archive, LayoutGrid, List, Plus
} from "lucide-react";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { VoiceCloningStudio } from "@/components/VoiceCloningStudio";

export default function AdminAgentsPage() {
  const [agents, setAgents] = useState<any[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [activeTab, setActiveTab] = useState<"workforce" | "voices" | "custom_voices">("workforce");
  const [isVoiceStudioOpen, setIsVoiceStudioOpen] = useState(false);
  const [viewMode, setViewMode] = useState<"grid" | "list">("grid");
  const [selectedVoiceId, setSelectedVoiceId] = useState<string | null>(null);

  // Filters & Search
  const [search, setSearch] = useState("");
  const [voiceFilter, setVoiceFilter] = useState("active");
  const [typeFilter, setTypeFilter] = useState("all");
  const [sortBy, setSortBy] = useState("newest");
  const [companyFilter, setCompanyFilter] = useState("all");
  const [genderFilter, setGenderFilter] = useState<"all" | "Male" | "Female">("all");
  const [quickFilter, setQuickFilter] = useState<"all" | "male" | "female" | "internal">("all");

  // Voice Preview State
  const [previewingVoiceId, setPreviewingVoiceId] = useState<string | null>(null);
  const [isPreviewLoading, setIsPreviewLoading] = useState(false);
  const previewAudioRef = useRef<HTMLAudioElement | null>(null);

  // Custom Voice Testing State
  const [testingCustomVoiceId, setTestingCustomVoiceId] = useState<string | null>(null);
  const [testLanguage, setTestLanguage] = useState<Record<string, string>>({});
  const [isPlaying, setIsPlaying] = useState<Record<string, boolean>>({});
  const [playbackRate, setPlaybackRate] = useState<Record<string, number>>({});
  const [fallbackProgress, setFallbackProgress] = useState<Record<string, number>>({});
  const [testAudioSrc, setTestAudioSrc] = useState<Record<string, string>>({});
  const [openMenuId, setOpenMenuId] = useState<string | null>(null);

  // Updating voice state
  const [updatingAgentId, setUpdatingAgentId] = useState<string | null>(null);
  const [successToast, setSuccessToast] = useState<string | null>(null);

  // Slide-over Drawer for Editing Agent
  const [selectedAgentForEdit, setSelectedAgentForEdit] = useState<any | null>(null);
  const [isSavingAgent, setIsSavingAgent] = useState(false);
  const [editFormData, setEditFormData] = useState({
    name: "",
    description: "",
    tts_voice: "",
    llm_model: "sarvam-105b",
    status: "active",
    default_language: "en-IN"
  });

  // Fallback player smooth progress simulation
  useEffect(() => {
    const interval = setInterval(() => {
      setFallbackProgress(prev => {
        const next = { ...prev };
        let changed = false;
        Object.keys(isPlaying).forEach(id => {
          if (isPlaying[id]) {
            // Assume 6 seconds total (6000ms). Add 100ms each tick (1.66% per tick)
            const current = next[id] || 0;
            if (current < 100) {
              next[id] = Math.min(100, current + 1.66);
              changed = true;
            }
          } else if (next[id] > 0) {
            // Snap to 0 when not playing
            next[id] = 0;
            changed = true;
          }
        });
        return changed ? next : prev;
      });
    }, 100);
    return () => clearInterval(interval);
  }, [isPlaying]);

  // Load Agents
  async function loadAgents() {
    setIsLoading(true);
    try {
      const data = await fetchApi<any>("/admin/agents");
      setAgents(data.agents || []);
    } catch (err) {
      console.error("Failed to load platform agents", err);
    } finally {
      setIsLoading(false);
    }
  }

  const [customVoices, setCustomVoices] = useState<any[]>([]);

  async function loadCustomVoices() {
    try {
      // In the admin dashboard, we can just query all or a specific company.
      // Assuming 'admin_workspace' is the company for platform admins, or using fetchApi directly.
      let compId = localStorage.getItem("zenaipex_active_company_id") || "admin_workspace";
      if (compId === "default") compId = "admin_workspace";
      const data = await fetchApi(`/companies/${compId}/voices`);
      if (data.voices) {
        const sorted = data.voices.sort((a: any, b: any) => {
          if (a.is_pinned && !b.is_pinned) return -1;
          if (!a.is_pinned && b.is_pinned) return 1;
          return new Date(b.created_at || 0).getTime() - new Date(a.created_at || 0).getTime();
        });
        setCustomVoices(sorted);
        if (sorted.length > 0) {
          setSelectedVoiceId(sorted[0].id);
        }
      }
    } catch (e) {
      console.error(e);
    }
  }

  useEffect(() => {
    loadAgents();
    loadCustomVoices();
    return () => {
      if (previewAudioRef.current) {
        previewAudioRef.current.pause();
        previewAudioRef.current = null;
      }
      if (typeof window !== "undefined" && "speechSynthesis" in window) {
        window.speechSynthesis.cancel();
      }
    };
  }, []);

  const filteredVoices = useMemo(() => {
    let result = customVoices.filter(v => {
      if (voiceFilter === "active") return !v.is_archived;
      if (voiceFilter === "archived") return !!v.is_archived;
      return true;
    }).filter(v => search === "" || v.name?.toLowerCase().includes(search.toLowerCase()));

    if (sortBy === "newest") {
      result = result.sort((a, b) => new Date(b.created_at || 0).getTime() - new Date(a.created_at || 0).getTime());
    } else if (sortBy === "oldest") {
      result = result.sort((a, b) => new Date(a.created_at || 0).getTime() - new Date(b.created_at || 0).getTime());
    } else if (sortBy === "az") {
      result = result.sort((a, b) => (a.name || "").localeCompare(b.name || ""));
    }

    return result;
  }, [customVoices, voiceFilter, search, sortBy]);

  // Voice Preview Play / Stop Handler
  const handlePlayVoicePreview = async (voice: Voice) => {
    if (previewingVoiceId === voice.id) {
      if (previewAudioRef.current) {
        previewAudioRef.current.pause();
        previewAudioRef.current = null;
      }
      if (typeof window !== "undefined" && "speechSynthesis" in window) {
        window.speechSynthesis.cancel();
      }
      setPreviewingVoiceId(null);
      setIsPreviewLoading(false);
      return;
    }

    if (previewAudioRef.current) {
      previewAudioRef.current.pause();
      previewAudioRef.current = null;
    }
    if (typeof window !== "undefined" && "speechSynthesis" in window) {
      window.speechSynthesis.cancel();
    }

    setPreviewingVoiceId(voice.id);
    setIsPreviewLoading(true);

    const fallbackBrowser = () => {
      setIsPreviewLoading(false);
      if (typeof window !== "undefined" && "speechSynthesis" in window) {
        const acoustics = getVoiceAcoustics(voice.id);
        const utterance = new SpeechSynthesisUtterance(voice.sampleText);
        utterance.lang = "en-IN";
        utterance.rate = acoustics.rate;
        utterance.pitch = acoustics.pitch;

        const synthVoices = window.speechSynthesis.getVoices();
        const match = findBrowserVoice(synthVoices, acoustics.isMale, "en-IN", voice.sampleText, voice.id);
        if (match) utterance.voice = match;

        utterance.onend = () => setPreviewingVoiceId(null);
        utterance.onerror = () => setPreviewingVoiceId(null);
        window.speechSynthesis.speak(utterance);
      } else {
        setPreviewingVoiceId(null);
      }
    };

    try {
      const res = await fetchApi<any>("/admin/agents/preview-voice", {
        method: "POST",
        body: JSON.stringify({
          voice: voice.id,
          text: voice.sampleText,
          language: "en-IN"
        })
      });
      setIsPreviewLoading(false);

      if (res && res.audio_base64 && !res.fallback_tts) {
        const audio = new Audio(`data:audio/mp3;base64,${res.audio_base64}`);
        previewAudioRef.current = audio;
        audio.onended = () => setPreviewingVoiceId(null);
        audio.onerror = () => fallbackBrowser();
        await audio.play();
      } else {
        fallbackBrowser();
      }
    } catch (err) {
      console.warn("Backend voice preview error, using browser synthesis fallback", err);
      fallbackBrowser();
    }
  };

  // Initialize cached audio from sessionStorage
  useEffect(() => {
    try {
      const saved = sessionStorage.getItem('zenaipex_voice_previews');
      if (saved) {
        setTestAudioSrc(JSON.parse(saved));
      }
    } catch (e) {
      console.warn("Could not load cached previews", e);
    }
  }, []);

  const updateTestAudioSrc = (id: string, b64: string) => {
    setTestAudioSrc(prev => {
      const next = { ...prev, [id]: b64 };
      try {
        sessionStorage.setItem('zenaipex_voice_previews', JSON.stringify(next));
      } catch (e) {
        console.warn("Could not save preview to cache", e);
      }
      return next;
    });
  };

  const handleTestCustomVoice = async (voiceId: string) => {
    setTestingCustomVoiceId(voiceId);

    const lang = testLanguage[voiceId] || "en-IN";
    const sampleTexts: Record<string, string> = {
      "en-IN": "Hello! I am your AI assistant. This is how my voice sounds in English.",
      "hi-IN": "नमस्ते! मैं आपका एआई असिस्टेंट हूँ। हिंदी में मेरी आवाज़ ऐसी लगती है।",
      "gu-IN": "નમસ્તે! હું તમારો એઆઈ આસિસ્ટન્ટ છું. ગુજરાતીમાં મારો અવાજ આવો સંભળાય છે."
    };
    const textToSpeak = sampleTexts[lang] || sampleTexts["en-IN"];

    try {
      let companyId = "admin_workspace";
      const token = localStorage.getItem("zenaipex_token");
      const formData = new FormData();
      formData.append("voice_id", voiceId);
      formData.append("text", textToSpeak);

      const res = await fetch(`http://localhost:8002/api/v1/companies/${companyId}/voices/test`, {
        method: "POST",
        body: formData,
        headers: { "Authorization": `Bearer ${token}` }
      });

      const data = await res.json();

      // Allow fallback if free tier error is intercepted by mock backend
      if (data.audio_b64) {
        updateTestAudioSrc(voiceId, data.audio_b64);
      } else if (!res.ok) {
        throw new Error("API failed");
      } else {
        setTestingCustomVoiceId(null);
      }
    } catch (e) {
      console.error("Test voice API error:", e);
      setTestingCustomVoiceId(null);
      alert("Error generating test audio.");
    }
  };

  // Change Agent Voice Platform-Wide
  const handleUpdateVoice = async (agentId: string, newVoiceId: string) => {
    setUpdatingAgentId(agentId);
    try {
      await fetchApi(`/admin/agents/${agentId}/voice`, {
        method: "PATCH",
        body: JSON.stringify({ tts_voice: newVoiceId })
      });
      setAgents(prev => prev.map(a => a.id === agentId ? { ...a, tts_voice: newVoiceId } : a));
      const voiceObj = getVoiceById(newVoiceId);
      const agentObj = agents.find(a => a.id === agentId);
      setSuccessToast(`Updated voice for "${agentObj?.name || 'Agent'}" to ${voiceObj.name} (${voiceObj.gender})`);
      setTimeout(() => setSuccessToast(null), 3500);
    } catch (err: any) {
      alert("Failed to update voice: " + (err.message || "Unknown error"));
    } finally {
      setUpdatingAgentId(null);
    }
  };

  // Open Edit Drawer
  const openEditDrawer = (agent: any) => {
    setSelectedAgentForEdit(agent);
    setEditFormData({
      name: agent.name || "",
      description: agent.description || "",
      tts_voice: agent.tts_voice || "ritu",
      llm_model: agent.llm_model || "sarvam-105b",
      status: agent.status || "active",
      default_language: agent.default_language || "en-IN"
    });
  };

  // Save Agent Details via Admin API
  const handleSaveAgentDetails = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!selectedAgentForEdit) return;

    setIsSavingAgent(true);
    try {
      await fetchApi(`/admin/agents/${selectedAgentForEdit.id}`, {
        method: "PATCH",
        body: JSON.stringify(editFormData)
      });
      setAgents(prev => prev.map(a => a.id === selectedAgentForEdit.id ? { ...a, ...editFormData } : a));
      setSuccessToast(`Successfully updated agent "${editFormData.name}"`);
      setTimeout(() => setSuccessToast(null), 3500);
      setSelectedAgentForEdit(null);
    } catch (err: any) {
      alert("Failed to save agent changes: " + (err.message || "Unknown error"));
    } finally {
      setIsSavingAgent(false);
    }
  };

  // Computed Metrics
  const uniqueCompanies = useMemo(() => {
    const map = new Map<string, string>();
    agents.forEach(a => {
      if (a.company_id) map.set(a.company_id, a.company_name || a.company_id);
    });
    return Array.from(map.entries()).map(([id, name]) => ({ id, name }));
  }, [agents]);

  const voiceUsageCounts = useMemo(() => {
    const counts: Record<string, number> = {};
    agents.forEach(a => {
      const v = (a.tts_voice || "ritu").toLowerCase();
      counts[v] = (counts[v] || 0) + 1;
    });
    return counts;
  }, [agents]);

  const mostPopularVoice = useMemo(() => {
    let topVoice = "ritu";
    let maxCount = -1;
    Object.entries(voiceUsageCounts).forEach(([v, count]) => {
      if (count > maxCount) {
        maxCount = count;
        topVoice = v;
      }
    });
    return getVoiceById(topVoice);
  }, [voiceUsageCounts]);

  // Filtered Agents
  const filteredAgents = useMemo(() => {
    return agents.filter(agent => {
      const matchesSearch =
        agent.name?.toLowerCase().includes(search.toLowerCase()) ||
        agent.company_name?.toLowerCase().includes(search.toLowerCase()) ||
        agent.company_id?.toLowerCase().includes(search.toLowerCase()) ||
        agent.tts_voice?.toLowerCase().includes(search.toLowerCase());

      const matchesCompany = companyFilter === "all" || agent.company_id === companyFilter;

      const voiceObj = getVoiceById(agent.tts_voice);
      const matchesGender = genderFilter === "all" || voiceObj.gender === genderFilter;

      let matchesQuick = true;
      if (quickFilter === "male") matchesQuick = voiceObj.gender === "Male";
      else if (quickFilter === "female") matchesQuick = voiceObj.gender === "Female";
      else if (quickFilter === "internal") matchesQuick = agent.company_name?.toLowerCase().includes("internal");

      return matchesSearch && matchesCompany && matchesGender && matchesQuick;
    });
  }, [agents, search, companyFilter, genderFilter, quickFilter]);

  return (
    <div className="space-y-6 max-w-[1600px] mx-auto pb-12">
      {/* Toast Notification */}
      {successToast && (
        <div className="fixed bottom-6 right-6 z-50 flex items-center gap-3 bg-slate-900 text-white px-5 py-3.5 rounded-2xl shadow-2xl border border-slate-700/80 animate-in fade-in slide-in-from-bottom-5">
          <CheckCircle2 className="h-5 w-5 text-emerald-400 shrink-0" />
          <span className="text-sm font-medium">{successToast}</span>
        </div>
      )}

      {/* ─────────────────── PLATFORM AI PIPELINE ARCHITECTURE BANNER (MATCHED TO WEBSITE THEME) ─────────────────── */}
      <div className="rounded-2xl border border-slate-200/90 bg-gradient-to-br from-emerald-50/40 via-white to-slate-50/60 p-6 shadow-xs relative overflow-hidden">
        <div className="absolute top-0 right-0 w-80 h-80 bg-emerald-100/30 rounded-full blur-3xl pointer-events-none -mr-20 -mt-20" />
        <div className="absolute bottom-0 left-1/3 w-64 h-64 bg-slate-100/50 rounded-full blur-3xl pointer-events-none" />

        <div className="relative z-10 space-y-5">
          {/* Header Row */}
          <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-100 pb-5">
            <div>
              <div className="flex items-center gap-2 mb-1.5 flex-wrap">
                <span className="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
                  <ShieldCheck className="h-3.5 w-3.5 text-emerald-600" /> Super Admin Command Center
                </span>
                <span className="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">
                  <Activity className="h-3 w-3 text-emerald-500 animate-pulse" /> Live System Telemetry
                </span>
              </div>
              <h1 className="text-2xl lg:text-3xl font-extrabold tracking-tight text-slate-900">
                Platform AI Agents & Voice Studio
              </h1>
              <p className="text-sm text-slate-600 mt-1 max-w-3xl">
                Enterprise control hub for customer AI agents, real-time voice synthesis engines, and multi-tenant workforce routing.
              </p>
            </div>

            <div className="flex items-center gap-3 self-start md:self-auto shrink-0">
              <Button
                variant="outline"
                size="sm"
                onClick={loadAgents}
                disabled={isLoading}
                className="bg-white hover:bg-slate-50 text-slate-700 border-slate-200 hover:border-slate-300 gap-2 h-9 px-4 rounded-xl shadow-xs"
              >
                <RefreshCw className={`h-4 w-4 ${isLoading ? 'animate-spin text-emerald-600' : ''}`} />
                Refresh Registry
              </Button>
            </div>
          </div>

          {/* Active Model Architecture Ribbon */}
          <div>
            <div className="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2.5 flex items-center gap-2">
              <Radio className="h-3.5 w-3.5 text-emerald-600" /> Active AI Model Architecture & Signal Flow
            </div>

            <div className="grid grid-cols-1 md:grid-cols-3 gap-3.5">
              {/* Voice Generation Card */}
              <div className="p-4 rounded-xl bg-white border border-slate-200/90 hover:border-emerald-300 hover:shadow-xs transition-all">
                <div className="flex items-center justify-between gap-2 mb-1.5">
                  <span className="text-xs font-bold text-slate-500 flex items-center gap-1.5">
                    <Mic className="h-3.5 w-3.5 text-pink-500" /> Voice Audio Output (TTS)
                  </span>
                  <span className="px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    Active
                  </span>
                </div>
                <div className="text-sm font-bold text-slate-900 flex items-center gap-2">
                  <span>Sarvam AI · Bulbul:v3</span>
                </div>
                <p className="text-[11px] text-slate-500 mt-1 leading-relaxed">
                  11 Certified Human Personas (5 Male · 6 Female) with High-Fidelity acoustic neural synthesis.
                </p>
              </div>

              {/* Intelligence / Brain Card */}
              <div className="p-4 rounded-xl bg-white border border-slate-200/90 hover:border-indigo-300 hover:shadow-xs transition-all">
                <div className="flex items-center justify-between gap-2 mb-1.5">
                  <span className="text-xs font-bold text-slate-500 flex items-center gap-1.5">
                    <Cpu className="h-3.5 w-3.5 text-indigo-500" /> Intelligence & Reasoning (LLM)
                  </span>
                  <span className="px-1.5 py-0.5 rounded text-[10px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
                    Multi-Model
                  </span>
                </div>
                <div className="text-sm font-bold text-slate-900 flex items-center gap-2">
                  <span>Sarvam-105b</span>
                  <span className="text-xs font-normal text-slate-500">· Fallback: Gemini / Groq</span>
                </div>
                <p className="text-[11px] text-slate-500 mt-1 leading-relaxed">
                  Orchestrated multi-turn conversational intelligence with dynamic persona grammar enforcement.
                </p>
              </div>

              {/* Speech-to-Text Recognition */}
              <div className="p-4 rounded-xl bg-white border border-slate-200/90 hover:border-amber-300 hover:shadow-xs transition-all">
                <div className="flex items-center justify-between gap-2 mb-1.5">
                  <span className="text-xs font-bold text-slate-500 flex items-center gap-1.5">
                    <Radio className="h-3.5 w-3.5 text-amber-500" /> Audio Hearing & STT
                  </span>
                  <span className="px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                    Dual-Stream
                  </span>
                </div>
                <div className="text-sm font-bold text-slate-900 flex items-center gap-2">
                  <span>Sarvam Saarika v2.5</span>
                  <span className="text-xs font-normal text-slate-500">+ Web Speech (en-IN)</span>
                </div>
                <p className="text-[11px] text-slate-500 mt-1 leading-relaxed">
                  Acoustic echo cancellation with instant sub-second user barge-in interruption.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* ─────────────────── STATS SUMMARY TILES ─────────────────── */}
      <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div className="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm relative overflow-hidden">
          <div className="flex items-center justify-between mb-2">
            <span className="text-xs font-bold uppercase tracking-wider text-slate-400">Platform Workforce</span>
            <div className="h-8 w-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold">
              <Bot className="h-4 w-4" />
            </div>
          </div>
          <div className="text-3xl font-extrabold text-slate-900 tracking-tight">{agents.length}</div>
          <div className="text-xs text-slate-500 mt-1 flex items-center gap-1.5">
            <span className="inline-block h-2 w-2 rounded-full bg-emerald-500" />
            {agents.filter(a => a.status === "active").length || agents.length} active voice agents deployed
          </div>
        </div>

        <div className="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm relative overflow-hidden">
          <div className="flex items-center justify-between mb-2">
            <span className="text-xs font-bold uppercase tracking-wider text-slate-400">Client Workspaces</span>
            <div className="h-8 w-8 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold">
              <Building2 className="h-4 w-4" />
            </div>
          </div>
          <div className="text-3xl font-extrabold text-slate-900 tracking-tight">{uniqueCompanies.length}</div>
          <div className="text-xs text-slate-500 mt-1">Distinct enterprise workspaces</div>
        </div>

        <div className="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm relative overflow-hidden">
          <div className="flex items-center justify-between mb-2">
            <span className="text-xs font-bold uppercase tracking-wider text-slate-400">Voice Catalog</span>
            <div className="h-8 w-8 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center font-bold">
              <Mic className="h-4 w-4" />
            </div>
          </div>
          <div className="text-3xl font-extrabold text-slate-900 tracking-tight">11 Personas</div>
          <div className="text-xs text-slate-500 mt-1 flex items-center gap-2">
            <span className="text-indigo-600 font-semibold">5 Male</span>
            <span>·</span>
            <span className="text-fuchsia-600 font-semibold">6 Female</span>
          </div>
        </div>

        <div className="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm relative overflow-hidden">
          <div className="flex items-center justify-between mb-2">
            <span className="text-xs font-bold uppercase tracking-wider text-slate-400">Top Assigned Voice</span>
            <div className="h-8 w-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
              <Volume2 className="h-4 w-4" />
            </div>
          </div>
          <div className="text-2xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
            <span>{mostPopularVoice.name}</span>
            <Badge
              variant="outline"
              className={`text-[10px] font-bold ${mostPopularVoice.gender === "Male"
                  ? "bg-indigo-50 text-indigo-700 border-indigo-200"
                  : "bg-fuchsia-50 text-fuchsia-700 border-fuchsia-200"
                }`}
            >
              {mostPopularVoice.gender}
            </Badge>
          </div>
          <div className="text-xs text-slate-500 mt-1">
            Assigned to {voiceUsageCounts[mostPopularVoice.id] || 0} agents
          </div>
        </div>
      </div>

      {/* ─────────────────── TAB CONTROLS & MASTER NAVIGATION ─────────────────── */}
      <div className="bg-white/80 backdrop-blur-md p-3 rounded-2xl border border-slate-200/80 shadow-lg flex flex-col sm:flex-row items-center justify-between gap-4 sticky top-4 z-20">
        <div className="flex bg-slate-100/80 p-1.5 rounded-xl gap-2 w-full sm:w-auto shadow-inner">
          <button
            onClick={() => setActiveTab("workforce")}
            className={`px-6 py-2.5 rounded-lg text-sm font-bold transition-all duration-300 flex items-center justify-center gap-2.5 ${activeTab === "workforce"
                ? "bg-white text-indigo-700 shadow-md ring-1 ring-indigo-100"
                : "text-slate-500 hover:text-slate-800 hover:bg-white/50"
              }`}
          >
            <Users className={`h-4 w-4 ${activeTab === "workforce" ? "text-indigo-600" : ""}`} />
            Platform Directory
            <span className="bg-indigo-100 text-indigo-700 px-2 py-0.5 rounded-full text-[10px] ml-1">{agents.length}</span>
          </button>

          <button
            onClick={() => setActiveTab("voices")}
            className={`px-6 py-2.5 rounded-lg text-sm font-bold transition-all duration-300 flex items-center justify-center gap-2.5 ${activeTab === "voices"
                ? "bg-white text-emerald-700 shadow-md ring-1 ring-emerald-100"
                : "text-slate-500 hover:text-slate-800 hover:bg-white/50"
              }`}
          >
            <Sparkles className={`h-4 w-4 ${activeTab === "voices" ? "text-emerald-600" : ""}`} />
            Voice Selection
            <span className="bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full text-[10px] ml-1">11</span>
          </button>

          <button
            onClick={() => setActiveTab("custom_voices")}
            className={`px-6 py-2.5 rounded-lg text-sm font-bold transition-all duration-300 flex items-center justify-center gap-2.5 ${activeTab === "custom_voices"
                ? "bg-white text-blue-700 shadow-md ring-1 ring-blue-100"
                : "text-slate-500 hover:text-slate-800 hover:bg-white/50"
              }`}
          >
            <Mic className={`h-4 w-4 ${activeTab === "custom_voices" ? "text-blue-600 animate-pulse" : ""}`} />
            My Voice Studio
            <span className="bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full text-[10px] ml-1 uppercase tracking-wider">Cloned</span>
          </button>
        </div>

        {/* Quick Search inside nav bar */}
        <div className="relative w-full sm:w-80">
          <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-slate-400" />
          <input
            type="text"
            placeholder="Search agents, companies, voices..."
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            className="w-full pl-9 pr-8 py-2 text-xs rounded-xl border border-slate-200 bg-slate-50/70 focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition-all text-slate-800"
          />
          {search && (
            <button
              onClick={() => setSearch("")}
              className="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600"
            >
              <X className="h-3.5 w-3.5" />
            </button>
          )}
        </div>
      </div>

      {/* ─────────────────── TAB 1: ENTERPRISE WORKFORCE DIRECTORY ─────────────────── */}
      {activeTab === "workforce" && (
        <div className="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden space-y-0">
          {/* Filter Toolbar */}
          <div className="p-4 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3 bg-slate-50/50">
            <div className="flex items-center gap-2 flex-wrap">
              <span className="text-xs font-semibold text-slate-500">Quick Filters:</span>
              <button
                onClick={() => setQuickFilter("all")}
                className={`px-3 py-1 rounded-lg text-xs font-medium border transition-all ${quickFilter === "all"
                    ? "bg-emerald-700 text-white border-emerald-700 shadow-xs"
                    : "bg-white text-slate-600 border-slate-200 hover:bg-slate-100"
                  }`}
              >
                All ({agents.length})
              </button>
              <button
                onClick={() => setQuickFilter("male")}
                className={`px-3 py-1 rounded-lg text-xs font-medium border transition-all ${quickFilter === "male"
                    ? "bg-indigo-600 text-white border-indigo-600"
                    : "bg-white text-indigo-700 border-slate-200 hover:bg-indigo-50"
                  }`}
              >
                Male Voices ({agents.filter(a => getVoiceById(a.tts_voice).gender === "Male").length})
              </button>
              <button
                onClick={() => setQuickFilter("female")}
                className={`px-3 py-1 rounded-lg text-xs font-medium border transition-all ${quickFilter === "female"
                    ? "bg-fuchsia-600 text-white border-fuchsia-600"
                    : "bg-white text-fuchsia-700 border-slate-200 hover:bg-fuchsia-50"
                  }`}
              >
                Female Voices ({agents.filter(a => getVoiceById(a.tts_voice).gender === "Female").length})
              </button>
              <button
                onClick={() => setQuickFilter("internal")}
                className={`px-3 py-1 rounded-lg text-xs font-medium border transition-all ${quickFilter === "internal"
                    ? "bg-emerald-600 text-white border-emerald-600"
                    : "bg-white text-emerald-700 border-slate-200 hover:bg-emerald-50"
                  }`}
              >
                Internal Platform
              </button>
            </div>

            {/* Dropdown Filters */}
            <div className="flex items-center gap-2">
              <select
                value={companyFilter}
                onChange={(e) => setCompanyFilter(e.target.value)}
                className="px-3 py-1.5 text-xs font-medium rounded-lg border border-slate-200 bg-white text-slate-700 hover:border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500"
              >
                <option value="all">All Companies ({uniqueCompanies.length})</option>
                {uniqueCompanies.map(c => (
                  <option key={c.id} value={c.id}>{c.name}</option>
                ))}
              </select>
            </div>
          </div>

          {/* Table */}
          <div className="overflow-x-auto">
            <table className="w-full text-sm text-left">
              <thead className="text-[11px] text-slate-500 uppercase bg-slate-50/80 border-b border-slate-200 tracking-wider">
                <tr>
                  <th className="px-6 py-4 font-bold">Agent Persona</th>
                  <th className="px-6 py-4 font-bold">Workspace / Tenant</th>
                  <th className="px-6 py-4 font-bold">Assigned Voice Persona</th>
                  <th className="px-6 py-4 font-bold">Listen Sample</th>
                  <th className="px-6 py-4 font-bold">Brain Model / Lang</th>
                  <th className="px-6 py-4 font-bold text-right">Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-100 bg-white">
                {isLoading ? (
                  <tr>
                    <td colSpan={6} className="px-6 py-16 text-center text-slate-500">
                      <div className="flex flex-col items-center justify-center gap-2.5">
                        <Loader2 className="h-7 w-7 animate-spin text-emerald-600" />
                        <span className="text-sm font-semibold text-slate-700">Loading Platform AI Registry...</span>
                      </div>
                    </td>
                  </tr>
                ) : filteredAgents.length === 0 ? (
                  <tr>
                    <td colSpan={6} className="px-6 py-16 text-center text-slate-500">
                      <div className="flex flex-col items-center justify-center gap-2">
                        <Bot className="h-10 w-10 text-slate-300 stroke-[1.5]" />
                        <span className="text-base font-bold text-slate-800">No agents match criteria</span>
                        <p className="text-xs text-slate-500">Try clearing filters or search query.</p>
                      </div>
                    </td>
                  </tr>
                ) : (
                  filteredAgents.map((agent) => {
                    const voiceObj = getVoiceById(agent.tts_voice);
                    const isPreviewingThis = previewingVoiceId === voiceObj.id;
                    const isInternalWorkspace = agent.company_name?.toLowerCase().includes("internal");

                    return (
                      <tr key={agent.id} className="hover:bg-slate-50/90 transition-colors group">
                        {/* Agent Name */}
                        <td className="px-6 py-4">
                          <div className="flex items-center gap-3.5">
                            <div
                              className={`h-10 w-10 rounded-xl flex items-center justify-center font-bold text-sm shrink-0 shadow-sm border ${voiceObj.gender === "Male"
                                  ? "bg-indigo-50 border-indigo-200/80 text-indigo-700"
                                  : "bg-fuchsia-50 border-fuchsia-200/80 text-fuchsia-700"
                                }`}
                            >
                              {agent.name.charAt(0).toUpperCase()}
                            </div>
                            <div>
                              <div className="font-bold text-slate-900 group-hover:text-emerald-700 transition-colors flex items-center gap-2">
                                <span>{agent.name}</span>
                                {agent.status === "active" && (
                                  <span className="inline-block h-2 w-2 rounded-full bg-emerald-500" title="Active" />
                                )}
                              </div>
                              <p className="text-xs text-slate-500 line-clamp-1 max-w-[240px] mt-0.5">
                                {agent.description || `Configured for ${agent.company_name}`}
                              </p>
                            </div>
                          </div>
                        </td>

                        {/* Company / Workspace */}
                        <td className="px-6 py-4">
                          <div className="flex items-center gap-2">
                            {isInternalWorkspace ? (
                              <Badge className="bg-emerald-100/90 text-emerald-800 border-emerald-300 gap-1 text-[11px] font-bold">
                                <ShieldCheck className="h-3 w-3" /> INTERNAL PLATFORM
                              </Badge>
                            ) : (
                              <div className="flex flex-col">
                                <span className="font-semibold text-slate-900 text-xs flex items-center gap-1.5">
                                  <Building2 className="h-3.5 w-3.5 text-slate-400" />
                                  {agent.company_name}
                                </span>
                                <span className="text-[10px] font-mono text-slate-400">ID: {agent.company_id.slice(0, 10)}...</span>
                              </div>
                            )}
                          </div>
                        </td>

                        {/* Assigned Voice Persona with Instant Dropdown Changer */}
                        <td className="px-6 py-4">
                          <div className="flex items-center gap-2.5">
                            <div className="relative">
                              <select
                                value={voiceObj.id}
                                disabled={updatingAgentId === agent.id}
                                onChange={(e) => handleUpdateVoice(agent.id, e.target.value)}
                                className="text-xs font-bold pl-3 pr-8 py-1.5 rounded-xl border border-slate-300 bg-white text-slate-800 hover:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 cursor-pointer shadow-sm disabled:opacity-50 appearance-none"
                              >
                                <optgroup label="Female Voice Personas (6)">
                                  {VOICES.filter(v => v.gender === "Female").map(v => (
                                    <option key={v.id} value={v.id}>
                                      {v.name} · {v.tone}
                                    </option>
                                  ))}
                                </optgroup>
                                <optgroup label="Male Voice Personas (5)">
                                  {VOICES.filter(v => v.gender === "Male").map(v => (
                                    <option key={v.id} value={v.id}>
                                      {v.name} · {v.tone}
                                    </option>
                                  ))}
                                </optgroup>
                              </select>
                              <ChevronDown className="absolute right-2.5 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-slate-400 pointer-events-none" />
                            </div>

                            <button
                              onClick={() => setIsVoiceStudioOpen(true)}
                              className="p-1.5 rounded-lg text-slate-400 hover:text-emerald-600 hover:bg-emerald-50 transition-colors"
                              title="Clone Custom Voice"
                            >
                              <Mic className="h-4 w-4" />
                            </button>

                            <Badge
                              variant="outline"
                              className={`text-[10px] uppercase font-bold tracking-wider shrink-0 ${voiceObj.gender === "Male"
                                  ? "bg-indigo-50 text-indigo-700 border-indigo-200"
                                  : "bg-fuchsia-50 text-fuchsia-700 border-fuchsia-200"
                                }`}
                            >
                              {voiceObj.gender}
                            </Badge>

                            {updatingAgentId === agent.id && (
                              <Loader2 className="h-3.5 w-3.5 animate-spin text-emerald-600" />
                            )}
                          </div>
                        </td>

                        {/* Listen Sample with Audio Equalizer Animation */}
                        <td className="px-6 py-4">
                          <button
                            onClick={() => handlePlayVoicePreview(voiceObj)}
                            disabled={isPreviewLoading && previewingVoiceId === voiceObj.id}
                            className={`inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-semibold border transition-all ${isPreviewingThis
                                ? "bg-red-600 text-white border-red-600 shadow-md shadow-red-500/20"
                                : "bg-white text-slate-700 border-slate-200 hover:bg-emerald-50 hover:text-emerald-700 hover:border-emerald-200 shadow-sm"
                              }`}
                          >
                            {isPreviewLoading && isPreviewingThis ? (
                              <Loader2 className="h-3.5 w-3.5 animate-spin" />
                            ) : isPreviewingThis ? (
                              <>
                                <Square className="h-3 w-3 fill-current" />
                                <span>Stop</span>
                                {/* Mini animated equalizer */}
                                <span className="flex items-end gap-0.5 h-3 ml-1">
                                  <span className="w-0.5 h-full bg-white animate-bounce" />
                                  <span className="w-0.5 h-2 bg-white animate-pulse" />
                                  <span className="w-0.5 h-3 bg-white animate-bounce" />
                                </span>
                              </>
                            ) : (
                              <>
                                <Play className="h-3 w-3 fill-current" />
                                <span>Listen Voice</span>
                              </>
                            )}
                          </button>
                        </td>

                        {/* Model & Language */}
                        <td className="px-6 py-4">
                          <div className="flex flex-col gap-1">
                            <span className="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-slate-800">
                              <Cpu className="h-3 w-3 text-indigo-500" />
                              {agent.llm_model || "sarvam-105b"}
                            </span>
                            <span className="text-[11px] text-slate-500 font-medium">
                              {agent.default_language === "en-IN" ? "🇮🇳 Hinglish / en-IN" : agent.default_language}
                            </span>
                          </div>
                        </td>

                        {/* Actions: Configure Drawer Button */}
                        <td className="px-6 py-4 text-right">
                          <Button
                            variant="ghost"
                            size="sm"
                            onClick={() => openEditDrawer(agent)}
                            className="text-xs font-semibold text-slate-600 hover:text-emerald-700 hover:bg-emerald-50 gap-1.5 rounded-xl h-8"
                          >
                            <Settings2 className="h-3.5 w-3.5" />
                            Configure
                          </Button>
                        </td>
                      </tr>
                    );
                  })
                )}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {/* ─────────────────── TAB 2: VOICE STUDIO & SOUND GALLERY ─────────────────── */}
      {activeTab === "voices" && (
        <div className="space-y-6">
          {/* Header Filter Pill Bar */}
          <div className="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
            <div className="flex items-center gap-3">
              <span className="text-xs font-bold uppercase tracking-wider text-slate-400">Gender Filter:</span>
              <div className="flex gap-1.5">
                {(["all", "Female", "Male"] as const).map(g => (
                  <button
                    key={g}
                    onClick={() => setGenderFilter(g)}
                    className={`px-3.5 py-1.5 text-xs font-bold rounded-xl border transition-all ${genderFilter === g
                        ? "bg-emerald-700 text-white border-emerald-700 shadow-xs"
                        : "bg-white text-slate-600 border-slate-200 hover:bg-slate-50"
                      }`}
                  >
                    {g === "all" ? "All Personas (11)" : `${g} Personas (${g === "Female" ? 6 : 5})`}
                  </button>
                ))}
              </div>
            </div>

            <div className="text-xs flex items-center gap-4">
              <div className="text-slate-500 hidden xl:flex items-center gap-2">
                <span className="h-2 w-2 rounded-full bg-emerald-500" />
                <span>Full Bulbul v3 acoustic spectrum</span>
              </div>
              <Button
                onClick={() => {
                  setActiveTab("custom_voices");
                  setIsVoiceStudioOpen(true);
                }}
                className="bg-[#3E5448] hover:bg-[#2C3B32] text-white rounded-xl h-9 text-xs shadow-sm"
              >
                <Mic className="h-3.5 w-3.5 mr-2" />
                Clone Custom Voice
              </Button>
            </div>
          </div>

          {/* 11 Voice Studio Cards */}
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {VOICES.filter(v => genderFilter === "all" || v.gender === genderFilter).map(voice => {
              const isPlaying = previewingVoiceId === voice.id;
              const assignedAgents = agents.filter(a => (a.tts_voice || "ritu").toLowerCase() === voice.id.toLowerCase());
              const acoustics = getVoiceAcoustics(voice.id);

              return (
                <div
                  key={voice.id}
                  className={`bg-white rounded-2xl border transition-all p-5 flex flex-col justify-between space-y-4 shadow-sm relative overflow-hidden ${isPlaying ? "border-emerald-500 ring-2 ring-emerald-500/20 shadow-lg" : "border-slate-200/80 hover:border-slate-300 hover:shadow-md"
                    }`}
                >
                  {/* Playing Pulse Banner */}
                  {isPlaying && (
                    <div className="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-emerald-500 via-teal-400 to-emerald-600 animate-pulse" />
                  )}

                  <div>
                    {/* Top Row: Name, Avatar, Gender */}
                    <div className="flex items-start justify-between gap-3 mb-3">
                      <div className="flex items-center gap-3">
                        <div
                          className={`h-12 w-12 rounded-2xl flex items-center justify-center font-extrabold text-base shrink-0 shadow-sm border ${voice.gender === "Male"
                              ? "bg-indigo-50 border-indigo-200 text-indigo-700"
                              : "bg-fuchsia-50 border-fuchsia-200 text-fuchsia-700"
                            }`}
                        >
                          {voice.name.charAt(0)}
                        </div>
                        <div>
                          <div className="flex items-center gap-2">
                            <h3 className="font-extrabold text-slate-900 text-base">{voice.name}</h3>
                            <Badge
                              variant="outline"
                              className={`text-[10px] font-bold uppercase tracking-wider ${voice.gender === "Male"
                                  ? "bg-indigo-50 text-indigo-700 border-indigo-200"
                                  : "bg-fuchsia-50 text-fuchsia-700 border-fuchsia-200"
                                }`}
                            >
                              {voice.gender}
                            </Badge>
                          </div>
                          <span className="text-xs font-semibold text-emerald-700 bg-emerald-50/80 px-2 py-0.5 rounded-md inline-block mt-1">
                            {voice.tone}
                          </span>
                        </div>
                      </div>

                      {/* Usage Badge */}
                      <Badge variant="secondary" className="text-xs bg-slate-100 text-slate-700 border-slate-200 font-semibold shrink-0">
                        {assignedAgents.length} {assignedAgents.length === 1 ? "Agent" : "Agents"}
                      </Badge>
                    </div>

                    <p className="text-xs text-slate-600 leading-relaxed mb-3.5">
                      {voice.description}
                    </p>

                    {/* Acoustic Telemetry Pill */}
                    <div className="flex items-center justify-between text-[11px] font-mono text-slate-600 bg-slate-50 p-2.5 rounded-xl border border-slate-100 mb-3.5">
                      <span className="text-slate-800 font-bold">Acoustics:</span>
                      <span>Pitch {acoustics.pitch.toFixed(2)}</span>
                      <span>·</span>
                      <span>Rate {acoustics.rate.toFixed(2)}x</span>
                      <span>·</span>
                      <span className="capitalize">{voice.accent || "Indian"}</span>
                    </div>

                    {/* Sample Dialogue Box */}
                    <div className="bg-slate-50/90 rounded-xl p-3.5 border border-slate-100 text-xs italic text-slate-700 relative">
                      <span className="font-bold text-slate-900 not-italic block mb-1 text-[11px] uppercase tracking-wider">
                        Sample Dialogue:
                      </span>
                      "{voice.sampleText}"
                    </div>
                  </div>

                  {/* Bottom Actions */}
                  <div className="space-y-3 pt-3 border-t border-slate-100">
                    <Button
                      onClick={() => handlePlayVoicePreview(voice)}
                      disabled={isPreviewLoading && previewingVoiceId === voice.id}
                      className={`w-full text-xs font-bold gap-2 py-2 rounded-xl transition-all ${isPlaying
                          ? "bg-red-600 hover:bg-red-700 text-white shadow-md shadow-red-500/20"
                          : "bg-emerald-700 hover:bg-emerald-800 text-white shadow-xs"
                        }`}
                    >
                      {isPreviewLoading && previewingVoiceId === voice.id ? (
                        <Loader2 className="h-4 w-4 animate-spin" />
                      ) : isPlaying ? (
                        <>
                          <Square className="h-3.5 w-3.5 fill-current" />
                          <span>Stop Audio Sample</span>
                        </>
                      ) : (
                        <>
                          <Play className="h-3.5 w-3.5 fill-current" />
                          <span>Listen Voice Sample</span>
                        </>
                      )}
                    </Button>

                    {/* Reassign to Agent Selector */}
                    <div className="space-y-1">
                      <label className="text-[11px] font-semibold text-slate-500 block">
                        Assign this voice to platform agent:
                      </label>
                      <select
                        onChange={(e) => {
                          if (e.target.value) {
                            handleUpdateVoice(e.target.value, voice.id);
                            e.target.value = "";
                          }
                        }}
                        defaultValue=""
                        className="w-full text-xs font-medium px-3 py-2 rounded-xl border border-slate-200 bg-slate-50 text-slate-700 hover:border-slate-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer"
                      >
                        <option value="" disabled>Choose an agent to reassign...</option>
                        {agents.map(a => (
                          <option key={a.id} value={a.id}>
                            {a.name} ({a.company_name}) {a.tts_voice?.toLowerCase() === voice.id.toLowerCase() ? "✓ Current" : ""}
                          </option>
                        ))}
                      </select>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {/* ─────────────────── TAB 3: CUSTOM VOICE STUDIO ─────────────────── */}
      {activeTab === "custom_voices" && (
        <div className="flex flex-col gap-6 items-start relative">
          {/* Studio Modal */}
          <VoiceCloningStudio
            isOpen={isVoiceStudioOpen}
            onClose={() => setIsVoiceStudioOpen(false)}
            onVoiceCreated={(v) => {
              loadCustomVoices();
              setIsVoiceStudioOpen(false);
            }}
          />

          {/* Right Panel: Gallery */}
          <div className="w-full flex-1 pb-12">
            <div className="bg-gradient-to-r from-slate-50 to-white p-6 rounded-3xl border border-slate-200/80 shadow-md flex flex-col xl:flex-row items-start xl:items-center justify-between gap-5 mb-8 relative overflow-hidden">
              <div className="absolute top-0 right-0 w-64 h-64 bg-emerald-100/30 rounded-full blur-3xl -mr-20 -mt-20 pointer-events-none" />
              <div className="relative z-10 flex flex-col">
                <h3 className="font-extrabold text-slate-900 text-2xl tracking-tight">My Custom Voices</h3>
                <p className="text-sm text-slate-500 mt-1 font-medium">Manage and assign voices you have cloned.</p>
              </div>
              <div className="relative z-10 flex flex-wrap items-center gap-3 w-full xl:w-auto">
                <Button
                  onClick={() => setIsVoiceStudioOpen(true)}
                  className="bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl h-10 text-sm font-bold shadow-[0_4px_14px_0_rgba(16,185,129,0.39)] hover:shadow-[0_6px_20px_rgba(16,185,129,0.23)] hover:-translate-y-0.5 transition-all duration-200 shrink-0 relative overflow-hidden group"
                >
                  <div className="absolute inset-0 bg-white/20 w-full h-full -translate-x-full group-hover:animate-[shimmer_1.5s_infinite]"></div>
                  <Plus className="h-4 w-4 mr-1.5" />
                  Create Voice
                </Button>
                <div className="relative flex-1 min-w-[160px]">
                  <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" />
                  <input
                    type="text"
                    value={search}
                    onChange={(e) => setSearch(e.target.value)}
                    placeholder="Search cloned voices..."
                    className="w-full pl-9 pr-4 py-2 text-sm rounded-xl border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition-all text-slate-800 shadow-sm h-10"
                  />
                </div>
                <div className="flex items-center gap-1.5 flex-wrap">
                  {/* Unified Filter Bar */}
                  <div className="flex items-center bg-white p-1 rounded-xl border border-slate-200/80 shadow-sm h-10">
                    <Filter className="h-3.5 w-3.5 text-slate-400 ml-2" />
                    <select
                      value={typeFilter}
                      onChange={(e) => setTypeFilter(e.target.value)}
                      className="px-2 py-1 text-[11px] font-bold bg-transparent text-slate-600 focus:outline-none cursor-pointer appearance-none"
                    >
                      <option value="all">All Types</option>
                      <option value="cloned">Cloned</option>
                      <option value="professional">Pro</option>
                    </select>
                    <div className="w-px h-4 bg-slate-200"></div>
                    <select
                      value={voiceFilter}
                      onChange={(e) => setVoiceFilter(e.target.value)}
                      className="px-2 py-1 text-[11px] font-bold bg-transparent text-slate-600 focus:outline-none cursor-pointer appearance-none"
                    >
                      <option value="active">Active</option>
                      <option value="archived">Archived</option>
                      <option value="all">All Status</option>
                    </select>
                    <div className="w-px h-4 bg-slate-200"></div>
                    <select
                      value={sortBy}
                      onChange={(e) => setSortBy(e.target.value)}
                      className="px-2 py-1 text-[11px] font-bold bg-transparent text-slate-600 focus:outline-none cursor-pointer appearance-none pr-3"
                    >
                      <option value="newest">Newest</option>
                      <option value="oldest">Oldest</option>
                      <option value="az">A-Z</option>
                    </select>
                  </div>

                  {/* View Mode Toggle */}
                  <div className="flex items-center bg-white border border-slate-200/80 rounded-xl p-1 shadow-sm h-10">
                    <button
                      onClick={() => setViewMode("list")}
                      className={`p-1.5 rounded-lg transition-colors ${viewMode === "list" ? "bg-slate-100 text-slate-900 shadow-sm" : "text-slate-400 hover:text-slate-600"}`}
                      title="List View"
                    >
                      <List className="h-4 w-4" />
                    </button>
                    <button
                      onClick={() => setViewMode("grid")}
                      className={`p-1.5 rounded-lg transition-colors ${viewMode === "grid" ? "bg-slate-100 text-slate-900 shadow-sm" : "text-slate-400 hover:text-slate-600"}`}
                      title="Grid View"
                    >
                      <LayoutGrid className="h-4 w-4" />
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <div className={viewMode === "grid" ? "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" : "flex flex-col bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden"}>
              {viewMode === "list" && filteredVoices.length > 0 && (
                <div className="flex items-center px-6 py-4 bg-slate-50/80 border-b border-slate-200/60 text-[10px] font-bold text-slate-500 uppercase tracking-wider">
                  <div className="w-[30%]">Voice Name</div>
                  <div className="w-[45%] pl-4">Audio Preview</div>
                  <div className="w-[25%] pr-4 text-right">Metrics & Status</div>
                </div>
              )}
              {filteredVoices.length === 0 ? (
                <div className="col-span-full py-12 flex flex-col items-center justify-center text-center bg-white rounded-2xl border border-slate-200 border-dashed">
                  <Mic className="h-12 w-12 text-slate-300 mb-4" />
                  <h4 className="text-sm font-bold text-slate-700">No Custom Voices Found</h4>
                  <p className="text-xs text-slate-500 mt-2 max-w-sm">Try adjusting your search or filter settings.</p>
                </div>
              ) : (
                filteredVoices.map(voice => (
                  <div
                    key={voice.id}
                    className={viewMode === "grid"
                      ? "bg-white rounded-3xl border border-[#E5E5E3] hover:border-emerald-300 hover:shadow-[0_8px_30px_rgb(0,0,0,0.06)] transition-all duration-300 p-5 flex flex-col justify-between group relative overflow-hidden h-full"
                      : "bg-white border-b last:border-b-0 border-slate-100 hover:bg-slate-50/50 transition-colors p-4 px-6 flex flex-row items-center gap-6 relative group w-full"
                    }
                  >
                    {/* Background glowing accent on hover */}
                    {viewMode === "grid" && (
                      <div className="absolute top-0 right-0 w-64 h-64 bg-emerald-400/10 rounded-full blur-[80px] opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none -mr-16 -mt-16"></div>
                    )}

                    <div className={`relative z-10 flex ${viewMode === "list" ? "flex-row items-center gap-6 w-full" : "flex-col h-full gap-3"}`}>
                      {/* Top Header */}
                      <div className={`flex items-start justify-between relative ${viewMode === "list" ? "w-[30%] shrink-0" : "gap-3"}`}>
                        <div className="flex items-center gap-3.5">
                          <div className="h-12 w-12 rounded-2xl bg-gradient-to-br from-slate-50 to-slate-100 border border-slate-200 text-slate-700 flex items-center justify-center font-black text-xl shadow-sm shrink-0 relative">
                            {voice.name?.charAt(0)?.toUpperCase() || "C"}
                            <div className="absolute -bottom-1 -right-1 h-4 w-4 bg-emerald-500 rounded-full border-2 border-white flex items-center justify-center">
                              <Check className="h-2 w-2 text-white" />
                            </div>
                          </div>
                          <div className="flex flex-col justify-center">
                            <h3 className="font-bold text-slate-900 text-lg tracking-tight leading-tight line-clamp-1 flex items-center gap-1.5">
                              {voice.name}
                              {voice.is_pinned && <span className="text-sm" title="Pinned">📌</span>}
                            </h3>
                            <div className="mt-0.5 flex items-center gap-1.5 text-[10px] text-slate-500 font-medium">
                              <Calendar className="h-3 w-3" />
                              {new Date(voice.created_at || Date.now()).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}
                            </div>
                          </div>
                        </div>

                        <div className="flex flex-col items-end gap-1">
                          <div className="flex items-center gap-1">
                            <Badge variant="secondary" className="text-[9px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-700 border-none px-1.5 py-0.5 rounded-md shadow-sm shrink-0">
                              ✨ Cloned
                            </Badge>
                            <button
                              onClick={(e) => {
                                e.stopPropagation();
                                setOpenMenuId(openMenuId === voice.id ? null : voice.id);
                              }}
                              className="p-1 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-md transition-colors"
                            >
                              <MoreVertical className="h-4 w-4" />
                            </button>
                          </div>

                          {openMenuId === voice.id && (
                            <div className="absolute top-8 right-0 w-40 bg-white/90 backdrop-blur-xl rounded-xl shadow-2xl border border-slate-200/60 py-1 z-50 animate-in fade-in zoom-in-95 duration-100">
                              <button
                                onClick={async () => {
                                  setOpenMenuId(null);
                                  const newName = prompt("Enter new name for this voice:", voice.name);
                                  if (newName && newName !== voice.name) {
                                    try {
                                      const formData = new FormData();
                                      formData.append("name", newName);
                                      const res = await fetch(`http://localhost:8002/api/v1/companies/admin_workspace/voices/${voice.id}`, {
                                        method: "PATCH",
                                        headers: { "Authorization": `Bearer ${localStorage.getItem("zenaipex_token")}` },
                                        body: formData
                                      });
                                      if (res.ok) loadCustomVoices();
                                    } catch (e) { alert("Failed to rename voice"); }
                                  }
                                }}
                                className="w-full text-left px-3 py-2 text-xs font-medium text-slate-700 hover:bg-emerald-50 hover:text-emerald-600 flex items-center gap-2 transition-colors"
                              >
                                <Edit3 className="h-3.5 w-3.5" /> Rename
                              </button>
                              <button
                                onClick={async () => {
                                  setOpenMenuId(null);
                                  const newPinned = !voice.is_pinned;
                                  // Optimistic UI update
                                  const newVoices = [...customVoices];
                                  const idx = newVoices.findIndex(v => v.id === voice.id);
                                  if (idx > -1) {
                                    newVoices[idx].is_pinned = newPinned;
                                    const sorted = newVoices.sort((a, b) => {
                                      if (a.is_pinned && !b.is_pinned) return -1;
                                      if (!a.is_pinned && b.is_pinned) return 1;
                                      return new Date(b.created_at || 0).getTime() - new Date(a.created_at || 0).getTime();
                                    });
                                    setCustomVoices(sorted);
                                  }

                                  try {
                                    const formData = new FormData();
                                    formData.append("is_pinned", newPinned.toString());
                                    await fetch(`http://localhost:8002/api/v1/companies/admin_workspace/voices/${voice.id}`, {
                                      method: "PATCH",
                                      headers: { "Authorization": `Bearer ${localStorage.getItem("zenaipex_token")}` },
                                      body: formData
                                    });
                                  } catch (e) { alert("Failed to pin voice"); }
                                }}
                                className="w-full text-left px-3 py-2 text-xs font-medium text-slate-700 hover:bg-emerald-50 hover:text-emerald-600 flex items-center gap-2 transition-colors"
                              >
                                <Pin className="h-3.5 w-3.5" /> {voice.is_pinned ? "Unpin" : "Pin to Top"}
                              </button>
                              <button
                                onClick={async () => {
                                  setOpenMenuId(null);
                                  const newArchived = !voice.is_archived;
                                  const action = newArchived ? "Archive" : "Unarchive";
                                  if (confirm(`${action} this voice?`)) {
                                    // Optimistic UI update
                                    setCustomVoices(prev => prev.map(v => v.id === voice.id ? { ...v, is_archived: newArchived } : v));

                                    try {
                                      const formData = new FormData();
                                      formData.append("is_archived", newArchived.toString());
                                      await fetch(`http://localhost:8002/api/v1/companies/admin_workspace/voices/${voice.id}`, {
                                        method: "PATCH",
                                        headers: { "Authorization": `Bearer ${localStorage.getItem("zenaipex_token")}` },
                                        body: formData
                                      });
                                    } catch (e) { alert(`Failed to ${action.toLowerCase()} voice`); }
                                  }
                                }}
                                className="w-full text-left px-3 py-2 text-xs font-medium text-slate-700 hover:bg-emerald-50 hover:text-emerald-600 flex items-center gap-2 transition-colors"
                              >
                                <Archive className="h-3.5 w-3.5" /> {voice.is_archived ? "Unarchive" : "Archive"}
                              </button>
                              <div className="h-px bg-slate-100 my-1"></div>
                              <button
                                onClick={async () => {
                                  setOpenMenuId(null);
                                  if (confirm("Are you sure you want to permanently delete this voice? This cannot be undone.")) {
                                    try {
                                      const res = await fetch(`http://localhost:8002/api/v1/companies/admin_workspace/voices/${voice.id}`, {
                                        method: "DELETE",
                                        headers: { "Authorization": `Bearer ${localStorage.getItem("zenaipex_token")}` }
                                      });
                                      if (res.ok) loadCustomVoices();
                                    } catch (e) { alert("Failed to delete voice"); }
                                  }
                                }}
                                className="w-full text-left px-3 py-2 text-xs font-medium text-red-600 hover:bg-red-50 flex items-center gap-2 transition-colors"
                              >
                                <Trash2 className="h-3.5 w-3.5" /> Delete Voice
                              </button>
                            </div>
                          )}
                        </div>
                      </div>

                      {/* Quality Warning (Mocked for demonstration if name contains 'mix' or randomly) */}
                      {viewMode === "grid" && (voice.name?.toLowerCase().includes('mix') || voice.voice_id.startsWith('mock_')) && (
                        <div className="bg-amber-50 border border-amber-200 rounded-xl p-2.5 flex items-start gap-2 shadow-sm">
                          <AlertTriangle className="h-4 w-4 text-amber-500 shrink-0 mt-0.5" />
                          <div className="flex flex-col">
                            <span className="text-[11px] font-bold text-amber-800">Multiple Voices Detected</span>
                            <span className="text-[10px] text-amber-700 leading-tight mt-0.5">Audio clarity is low. For best AI cloning results, please upload a clear, single-speaker file.</span>
                          </div>
                        </div>
                      )}

                      <div className={`flex flex-col justify-center gap-2.5 ${viewMode === "list" ? "w-[45%] shrink-0 pl-4" : "flex-1"}`}>
                        {/* Audio Controls Area */}
                        <div className={`bg-slate-50/50 rounded-xl border border-slate-100 flex flex-col gap-2 relative overflow-hidden group/controls ${viewMode === "list" ? "p-2" : "p-3"}`}>
                          {/* Inner breathing glow */}
                          <div className="absolute inset-0 bg-gradient-to-r from-emerald-50/50 to-transparent opacity-0 group-hover/controls:opacity-100 transition-opacity duration-1000 pointer-events-none"></div>

                          <div className="flex items-center justify-between relative z-10">
                            <span className="text-xs font-semibold text-slate-500 flex items-center gap-1.5"><Mic className="h-3.5 w-3.5 text-emerald-500" /> AI Preview</span>
                            <div className="flex items-center gap-2">
                              <select
                                value={playbackRate[voice.voice_id] || 1}
                                onChange={(e) => {
                                  const rate = parseFloat(e.target.value);
                                  setPlaybackRate(prev => ({ ...prev, [voice.voice_id]: rate }));
                                  const audioEl = document.getElementById(`audio-${voice.voice_id}`) as HTMLAudioElement;
                                  if (audioEl) audioEl.playbackRate = rate;
                                }}
                                className="bg-white text-[10px] font-bold px-2 py-1.5 rounded-lg border border-slate-200 text-slate-600 focus:outline-none cursor-pointer shadow-sm hover:border-emerald-300 transition-colors"
                              >
                                <option value="0.5">0.5x</option>
                                <option value="1">1x Speed</option>
                                <option value="1.5">1.5x</option>
                                <option value="2">2x Speed</option>
                              </select>

                              <select
                                value={testLanguage[voice.voice_id] || "en-IN"}
                                onChange={(e) => setTestLanguage(prev => ({ ...prev, [voice.voice_id]: e.target.value }))}
                                className="bg-white text-[10px] font-bold px-2 py-1.5 rounded-lg border border-slate-200 text-slate-600 focus:outline-none cursor-pointer shadow-sm hover:border-emerald-300 transition-colors"
                              >
                                <option value="en-IN">EN</option>
                                <option value="hi-IN">HI</option>
                                <option value="gu-IN">GU</option>
                              </select>
                            </div>
                          </div>

                          <div className="w-full flex flex-col gap-2 relative z-10">
                            {testAudioSrc[voice.voice_id] ? (
                              <div className="flex flex-col gap-2 w-full bg-white border border-slate-200 rounded-xl p-2 shadow-sm">
                                <audio
                                  id={`audio-${voice.voice_id}`}
                                  controls
                                  src={`data:audio/mp3;base64,${testAudioSrc[voice.voice_id]}`}
                                  className="w-full h-11 outline-none rounded-lg"
                                  onPlay={() => setIsPlaying(prev => ({ ...prev, [voice.voice_id]: true }))}
                                  onPause={() => setIsPlaying(prev => ({ ...prev, [voice.voice_id]: false }))}
                                  onEnded={() => setIsPlaying(prev => ({ ...prev, [voice.voice_id]: false }))}
                                  onError={(e) => {
                                    const target = e.target as HTMLAudioElement;
                                    target.removeAttribute('id'); // Remove ID so fallback synthesis triggers
                                    target.style.display = 'none'; // Hide native player if it's broken

                                    const fallbackEl = document.getElementById(`fallback-ui-${voice.voice_id}`);
                                    if (fallbackEl) {
                                      fallbackEl.classList.remove('hidden');
                                      fallbackEl.classList.add('flex');
                                    }
                                  }}
                                />

                                {/* Fallback UI that only shows if the native player is hidden (i.e. broke) */}
                                <div className="hidden items-center justify-between px-2" id={`fallback-ui-${voice.voice_id}`}>
                                  <div className="flex items-center gap-3 w-full">
                                    <button
                                      onClick={() => {
                                        if (isPlaying[voice.voice_id]) {
                                          window.speechSynthesis.cancel();
                                          setIsPlaying(prev => ({ ...prev, [voice.voice_id]: false }));
                                        } else {
                                          const utterance = new SpeechSynthesisUtterance("Hello, this is a fallback browser synthesis because the MP3 format failed to load.");
                                          utterance.lang = testLanguage[voice.voice_id] || "en-IN";
                                          utterance.rate = playbackRate[voice.voice_id] || 1;
                                          setIsPlaying(prev => ({ ...prev, [voice.voice_id]: true }));
                                          utterance.onend = () => setIsPlaying(prev => ({ ...prev, [voice.voice_id]: false }));
                                          window.speechSynthesis.speak(utterance);
                                        }
                                      }}
                                      className="h-8 w-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center hover:bg-emerald-100 hover:scale-105 transition-all shrink-0 shadow-sm"
                                    >
                                      {isPlaying[voice.voice_id] ? <Pause className="h-4 w-4" /> : <Play className="h-4 w-4 ml-0.5" />}
                                    </button>

                                    <div className="flex-1 relative h-1.5 bg-slate-100 rounded-full overflow-hidden">
                                      <div
                                        className="absolute top-0 left-0 h-full bg-emerald-400 rounded-full transition-all duration-100 ease-linear shadow-[0_0_8px_rgba(52,211,153,0.5)]"
                                        style={{ width: `${fallbackProgress[voice.voice_id] || 0}%` }}
                                      ></div>
                                    </div>

                                    {/* Programmatic Equalizer tied to fallbackProgress */}
                                    <div className={`flex items-end gap-0.5 h-3 ${isPlaying[voice.voice_id] ? 'opacity-100' : 'opacity-40'} transition-opacity`}>
                                      <div className="w-1 bg-emerald-500 rounded-full transition-all duration-100" style={{ height: isPlaying[voice.voice_id] ? `${20 + Math.abs(Math.sin((fallbackProgress[voice.voice_id] || 0) * 0.1)) * 80}%` : '30%' }}></div>
                                      <div className="w-1 bg-emerald-500 rounded-full transition-all duration-100" style={{ height: isPlaying[voice.voice_id] ? `${20 + Math.abs(Math.cos((fallbackProgress[voice.voice_id] || 0) * 0.15)) * 80}%` : '50%' }}></div>
                                      <div className="w-1 bg-emerald-500 rounded-full transition-all duration-100" style={{ height: isPlaying[voice.voice_id] ? `${20 + Math.abs(Math.sin((fallbackProgress[voice.voice_id] || 0) * 0.08)) * 80}%` : '40%' }}></div>
                                    </div>

                                    <span className="text-[10px] font-mono font-bold text-slate-400 shrink-0 w-16 text-right tabular-nums tracking-tighter">
                                      0:0{Math.floor(((fallbackProgress[voice.voice_id] || 0) / 100) * 6)} / 0:06
                                    </span>
                                  </div>
                                </div>

                                <a
                                  href={`data:audio/mp3;base64,${testAudioSrc[voice.voice_id]}`}
                                  download={`${voice.name}_preview.mp3`}
                                  className="w-full h-8 bg-slate-50 border border-slate-200 rounded-lg flex items-center justify-center gap-1.5 text-slate-500 hover:text-emerald-600 hover:border-emerald-300 hover:bg-emerald-50 transition-all shadow-sm text-[11px] font-bold mt-1 group"
                                  title="Download Audio"
                                >
                                  <Download className="h-3.5 w-3.5 group-hover:-translate-y-0.5 transition-transform" /> Download Audio File
                                </a>
                              </div>
                            ) : (
                              <Button
                                variant="outline"
                                className="w-full h-10 bg-white border-slate-200 hover:border-emerald-400 hover:text-emerald-700 text-slate-600 transition-all rounded-xl shadow-[0_2px_10px_rgba(0,0,0,0.02)] hover:shadow-[0_4px_15px_rgba(52,211,153,0.15)] font-semibold group/btn relative overflow-hidden"
                                onClick={() => handleTestCustomVoice(voice.voice_id)}
                                disabled={testingCustomVoiceId === voice.voice_id}
                              >
                                {testingCustomVoiceId === voice.voice_id ? (
                                  <>
                                    <div className="absolute inset-0 bg-gradient-to-r from-transparent via-emerald-100/30 to-transparent animate-[shimmer_1.5s_infinite] w-[200%] -ml-[100%]"></div>
                                    <Loader2 className="mr-2 h-4 w-4 animate-spin text-emerald-500 relative z-10" />
                                    <span className="relative z-10 text-emerald-700">Analyzing & Synthesizing...</span>
                                  </>
                                ) : (
                                  <>
                                    <div className="absolute inset-0 bg-emerald-50 opacity-0 group-hover/btn:opacity-100 transition-opacity"></div>
                                    <Play className="mr-2 h-4 w-4 text-emerald-500 group-hover/btn:scale-110 transition-transform relative z-10" />
                                    <span className="relative z-10">Generate Preview</span>
                                  </>
                                )}
                              </Button>
                            )}
                          </div>
                        </div>
                      </div>

                      {/* Footer Metrics - Glowing Rings */}
                      <div className={`flex items-center justify-between ${viewMode === "list" ? "w-[25%] shrink-0 pr-4 justify-end gap-6" : "pt-4 border-t border-slate-100 mt-auto"}`}>
                        <div className="flex items-center gap-4">
                          {/* Clarity Ring */}
                          <div className="flex items-center gap-2 group/ring">
                            <div className="relative h-8 w-8 flex items-center justify-center">
                              <svg className="h-full w-full -rotate-90 transform" viewBox="0 0 36 36">
                                {/* Background Circle */}
                                <path className="text-slate-100" strokeWidth="3" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                {/* Progress Circle - 94% */}
                                <path className="text-emerald-400 group-hover/ring:text-emerald-500 transition-colors duration-500 drop-shadow-[0_0_3px_rgba(52,211,153,0.4)]" strokeWidth="3" strokeDasharray="94, 100" strokeLinecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                              </svg>
                              <div className="absolute inset-0 flex items-center justify-center text-[8px] font-black text-slate-700">94</div>
                            </div>
                            <span className="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Clarity</span>
                          </div>

                          {/* Stability Ring */}
                          <div className="flex items-center gap-2 group/ring">
                            <div className="relative h-8 w-8 flex items-center justify-center">
                              <svg className="h-full w-full -rotate-90 transform" viewBox="0 0 36 36">
                                {/* Background Circle */}
                                <path className="text-slate-100" strokeWidth="3" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                {/* Progress Circle - 85% for High */}
                                <path className="text-blue-400 group-hover/ring:text-blue-500 transition-colors duration-500 drop-shadow-[0_0_3px_rgba(96,165,250,0.4)]" strokeWidth="3" strokeDasharray="85, 100" strokeLinecap="round" stroke="currentColor" fill="none" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                              </svg>
                              <div className="absolute inset-0 flex items-center justify-center">
                                <Sparkles className="h-3 w-3 text-blue-500" />
                              </div>
                            </div>
                            <span className="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Stability</span>
                          </div>
                        </div>

                        {viewMode === "grid" && (
                          <div className="text-[9px] font-mono text-slate-400 bg-slate-50 hover:bg-slate-100 transition-colors px-2 py-1 rounded-md border border-slate-200 shadow-sm cursor-pointer" title="Copy ID">
                            {voice.voice_id.slice(0, 8)}
                          </div>
                        )}
                      </div>
                    </div>

                    {viewMode === "grid" && (
                      <div className="mt-5 pt-4 border-t border-slate-100 relative z-10">
                        <div className="space-y-2">
                          <label className="text-[11px] font-bold text-slate-600 flex items-center gap-1.5">
                            <Users className="h-3 w-3" /> Assign to Agent
                          </label>
                          <select
                            onChange={(e) => {
                              if (e.target.value) {
                                handleUpdateVoice(e.target.value, voice.voice_id);
                                e.target.value = "";
                              }
                            }}
                            defaultValue=""
                            className="w-full text-xs font-semibold px-3 py-2.5 rounded-xl border border-slate-200 bg-white text-slate-700 hover:border-emerald-300 focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer shadow-sm transition-all"
                          >
                            <option value="" disabled>Choose an agent...</option>
                            {agents.map(a => (
                              <option key={a.id} value={a.id}>
                                {a.name} ({a.company_name})
                              </option>
                            ))}
                          </select>
                        </div>
                      </div>
                    )}
                  </div>
                ))
              )}
            </div>
          </div>
        </div>
      )}

      {/* ─────────────────── SLIDE-OVER AGENT CONFIGURATION DRAWER ─────────────────── */}
      {selectedAgentForEdit && (
        <div className="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm flex justify-end animate-in fade-in duration-200">
          <div className="w-full max-w-md bg-white h-full shadow-2xl flex flex-col justify-between border-l border-slate-200 animate-in slide-in-from-right duration-300">
            {/* Drawer Header */}
            <div className="p-6 border-b border-slate-100 flex items-center justify-between">
              <div>
                <span className="text-xs font-bold uppercase tracking-wider text-emerald-600">Platform Admin Config</span>
                <h3 className="text-lg font-bold text-slate-900 mt-0.5">{selectedAgentForEdit.name}</h3>
                <p className="text-xs text-slate-500 font-mono">Workspace: {selectedAgentForEdit.company_name}</p>
              </div>
              <button
                onClick={() => setSelectedAgentForEdit(null)}
                className="p-2 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors"
              >
                <X className="h-5 w-5" />
              </button>
            </div>

            {/* Drawer Body Form */}
            <form id="agent-edit-form" onSubmit={handleSaveAgentDetails} className="p-6 space-y-5 overflow-y-auto flex-1">
              {/* Agent Name */}
              <div className="space-y-1.5">
                <label className="text-xs font-bold text-slate-700">Agent Display Name</label>
                <input
                  type="text"
                  value={editFormData.name}
                  onChange={(e) => setEditFormData({ ...editFormData, name: e.target.value })}
                  required
                  className="w-full px-3.5 py-2 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                />
              </div>

              {/* Description */}
              <div className="space-y-1.5">
                <label className="text-xs font-bold text-slate-700">Description / Role</label>
                <textarea
                  value={editFormData.description}
                  onChange={(e) => setEditFormData({ ...editFormData, description: e.target.value })}
                  rows={2}
                  className="w-full px-3.5 py-2 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                />
              </div>

              {/* Voice Persona Selector */}
              <div className="space-y-1.5">
                <label className="text-xs font-bold text-slate-700 flex items-center justify-between">
                  <span>Voice Persona (Sarvam Bulbul v3)</span>
                  <span className="text-[11px] font-normal text-emerald-600">11 Available</span>
                </label>
                <select
                  value={editFormData.tts_voice}
                  onChange={(e) => setEditFormData({ ...editFormData, tts_voice: e.target.value })}
                  className="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-slate-50/50"
                >
                  <optgroup label="Female Voices">
                    {VOICES.filter(v => v.gender === "Female").map(v => (
                      <option key={v.id} value={v.id}>
                        {v.name} (Female · {v.tone})
                      </option>
                    ))}
                  </optgroup>
                  <optgroup label="Male Voices">
                    {VOICES.filter(v => v.gender === "Male").map(v => (
                      <option key={v.id} value={v.id}>
                        {v.name} (Male · {v.tone})
                      </option>
                    ))}
                  </optgroup>
                </select>
              </div>

              {/* LLM Model Selector */}
              <div className="space-y-1.5">
                <label className="text-xs font-bold text-slate-700">AI Intelligence Model (Brain)</label>
                <select
                  value={editFormData.llm_model}
                  onChange={(e) => setEditFormData({ ...editFormData, llm_model: e.target.value })}
                  className="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-slate-50/50"
                >
                  <option value="sarvam-105b">Sarvam AI · sarvam-105b (Recommended for Indian Languages)</option>
                  <option value="sarvam-105b-conversations">Sarvam AI · sarvam-105b-conversations</option>
                  <option value="gemini-1.5-flash">Google · gemini-1.5-flash</option>
                  <option value="gemini-2.0-flash">Google · gemini-2.0-flash</option>
                  <option value="llama-3.3-70b-versatile">Groq · llama-3.3-70b-versatile (Ultra-Fast)</option>
                </select>
              </div>

              {/* Status */}
              <div className="space-y-1.5">
                <label className="text-xs font-bold text-slate-700">Agent Deployment Status</label>
                <select
                  value={editFormData.status}
                  onChange={(e) => setEditFormData({ ...editFormData, status: e.target.value })}
                  className="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-slate-50/50"
                >
                  <option value="active">Active (Serving customer calls and voice mode)</option>
                  <option value="draft">Draft / Paused (Hidden from callers)</option>
                </select>
              </div>

              {/* Language */}
              <div className="space-y-1.5">
                <label className="text-xs font-bold text-slate-700">Default Language</label>
                <select
                  value={editFormData.default_language}
                  onChange={(e) => setEditFormData({ ...editFormData, default_language: e.target.value })}
                  className="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 bg-slate-50/50"
                >
                  <option value="en-IN">🇮🇳 Hinglish / Indian English (en-IN)</option>
                  <option value="hi-IN">🇮🇳 Pure Hindi (hi-IN)</option>
                  <option value="gu-IN">🇮🇳 Gujarati (gu-IN)</option>
                </select>
              </div>
            </form>

            {/* Drawer Footer */}
            <div className="p-6 border-t border-slate-100 flex items-center justify-end gap-3 bg-slate-50/80">
              <Button
                type="button"
                variant="outline"
                onClick={() => setSelectedAgentForEdit(null)}
                className="rounded-xl h-10 px-5 text-xs font-bold text-slate-600"
              >
                Cancel
              </Button>
              <Button
                type="submit"
                form="agent-edit-form"
                disabled={isSavingAgent}
                className="rounded-xl h-10 px-6 text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white gap-2 shadow-sm"
              >
                {isSavingAgent ? <Loader2 className="h-4 w-4 animate-spin" /> : <Check className="h-4 w-4" />}
                Save Agent Settings
              </Button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
